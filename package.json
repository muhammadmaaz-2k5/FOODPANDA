{
  "name": "foodpanda-backend",
  "version": "1.0.0",
  "description": "Comprehensive Food Delivery Platform Backend with Node.js, Prisma ORM, Cloudinary, Mapbox, and Socket.IO",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "npx prisma studio",
    "test": "node tests/api.test.js"
  },
  "keywords": [
    "food-delivery",
    "nodejs",
    "express",
    "prisma",
    "postgresql",
    "socket.io",
    "cloudinary",
    "mapbox"
  ],
  "author": "FoodPanda Dev Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "prisma": "^5.19.1"
  }
}
