generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  BANNED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum FoodItemStatus {
  AVAILABLE
  UNAVAILABLE
}

enum CartStatus {
  ACTIVE
  ORDERED
  ABANDONED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  ENROUTE
  DELIVERED
  CANCELLED
  REJECTED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum DeliveryTier {
  STANDARD
  EXPRESS
  PRIORITY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  REFUND_PENDING
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  BUSY
  ON_DELIVERY
}

enum RiderVehicleType {
  BIKE
  SCOOTER
  CAR
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
  BUY_ONE_GET_ONE
}

enum PromotionType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  FREE_DELIVERY
  BUY_ONE_GET_ONE
}

enum PromotionScope {
  RESTAURANT
  PLATFORM
}

enum MediaType {
  IMAGE
  VIDEO
}

enum EntityType {
  USER
  RESTAURANT
  FOOD
  PROMOTION
  BANNER
}

enum BannerPlacement {
  HOME
  CATEGORY
  RESTAURANT_DETAIL
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationType {
  ORDER
  PROMOTION
  SYSTEM
  MESSAGE
}

enum ConversationType {
  CUSTOMER_RESTAURANT
  CUSTOMER_RIDER
}

enum ConversationStatus {
  OPEN
  CLOSED
}

// ============================================================
// AUTH & RBAC
// ============================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  passwordHash  String
  firstName     String
  lastName      String?
  phone         String?
  avatarUrl     String?
  gender        Gender?
  dateOfBirth   DateTime?
  status        UserStatus   @default(ACTIVE)
  roleId        Int
  role          Role         @relation(fields: [roleId], references: [id])
  addresses     Address[]
  cart          Cart[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  couponUsages  CouponUsage[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  rider         Rider?
  restaurantStaff RestaurantStaff[]
  ownedRestaurants Restaurant[] @relation("OwnedRestaurants")
  conversations ConversationParticipant[]
  messages      Message[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================
// RESTAURANT
// ============================================================

model Restaurant {
  id            String           @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  phone          String?
  email          String?
  logoUrl        String?
  coverUrl       String?
  status         RestaurantStatus @default(PENDING)
  rating         Float            @default(0)
  ratingCount    Int              @default(0)
  orderCount     Int              @default(0)
  deliveryTimeMin Int?
  deliveryTimeMax Int?
  priceRange     Int              @default(1)
  latitude       Float
  longitude      Float
  addressLine    String?
  city           String?
  postalCode     String?
  ownerId        String           @db.Uuid
  owner          User             @relation("OwnedRestaurants", fields: [ownerId], references: [id])
  staff          RestaurantStaff[]
  categories     RestaurantCategory[]
  foodCategories FoodCategory[]
  foodItems      FoodItem[]
  carts          Cart[]
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
  promotions     Promotion[]
  coupons       Coupon[]
  deliveryZoneId String?          @db.Uuid
  deliveryZone   DeliveryZone?    @relation(fields: [deliveryZoneId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([latitude, longitude])
  @@index([rating])
  @@index([ownerId])
  @@map("restaurants")
}

model RestaurantStaff {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  position     String?
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@index([userId])
  @@map("restaurant_staff")
}

model RestaurantCategory {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  iconUrl      String?
  restaurants  Restaurant[]
  createdAt    DateTime   @default(now())

  @@map("restaurant_categories")
}

// ============================================================
// MENU
// ============================================================

model FoodCategory {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodItems    FoodItem[]
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@map("food_categories")
}

model FoodItem {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  price         Float
  discountedPrice Float?
  imageUrl      String?
  status        FoodItemStatus @default(AVAILABLE)
  rating        Float          @default(0)
  ratingCount   Int            @default(0)
  orderCount    Int            @default(0)
  isVegetarian  Boolean        @default(false)
  isVegan       Boolean        @default(false)
  isPopular     Boolean        @default(false)
  preparationTime Int?
  calories      Int?
  restaurantId  String         @db.Uuid
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId    String?        @db.Uuid
  category      FoodCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variations    FoodVariation[]
  addons        FoodAddon[]
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  searchIndex   SearchIndex?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([restaurantId])
  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([rating])
  @@index([isPopular])
  @@map("food_items")
}

model FoodVariation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  price     Float
  foodItemId String  @db.Uuid
  foodItem  FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([foodItemId])
  @@map("food_variations")
}

model FoodAddon {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  price      Float
  foodItemId String   @db.Uuid
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([foodItemId])
  @@map("food_addons")
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  line1       String
  line2       String?
  city        String
  postalCode  String?
  latitude    Float
  longitude   Float
  notes       String?
  isDefault   Boolean  @default(false)
  deliveryOrders Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// CART
// ============================================================

model Cart {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String    @db.Uuid
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  status      CartStatus @default(ACTIVE)
  items       CartItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, restaurantId, status])
  @@index([userId])
  @@map("carts")
}

model CartItem {
  id           String        @id @default(uuid()) @db.Uuid
  cartId       String        @db.Uuid
  cart         Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  foodItemId   String        @db.Uuid
  foodItem     FoodItem      @relation(fields: [foodItemId], references: [id])
  quantity     Int           @default(1)
  variationId  String?       @db.Uuid
  addonIds     String[]      @db.Uuid
  specialInstructions String?
  unitPrice    Float
  totalPrice   Float
  createdAt    DateTime      @default(now())

  @@index([cartId])
  @@map("cart_items")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id              String             @id @default(uuid()) @db.Uuid
  orderNumber     String             @unique
  userId          String             @db.Uuid
  user            User               @relation(fields: [userId], references: [id])
  restaurantId    String             @db.Uuid
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id])
  status          OrderStatus        @default(PENDING)
  type            OrderType          @default(DELIVERY)
  deliveryTier    DeliveryTier       @default(STANDARD)
  subtotal        Float
  deliveryFee     Float              @default(0)
  discountAmount  Float              @default(0)
  taxAmount       Float              @default(0)
  total           Float
  paymentStatus    PaymentStatus     @default(PENDING)
  paymentMethod   PaymentMethod?
  deliveryAddressId String?          @db.Uuid
  deliveryAddress  Address?           @relation(fields: [deliveryAddressId], references: [id])
  deliveryLatitude Float?
  deliveryLongitude Float?
  deliveryInstructions String?
  couponUsage     CouponUsage?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  riderAssignment RiderAssignment?
  payment         Payment?
  review          Review?
  conversation    Conversation?
  estimatedPrepTime Int?
  estimatedDeliveryTime Int?
  actualDeliveryTime DateTime?
  cancellationReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([restaurantId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItemId    String   @db.Uuid
  foodItem      FoodItem @relation(fields: [foodItemId], references: [id])
  name          String
  quantity      Int
  unitPrice     Float
  variationName String?
  addonNames    String[]
  totalPrice    Float
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdBy String      @db.Uuid
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([status])
  @@map("order_status_history")
}

// ============================================================
// RIDER
// ============================================================

model Rider {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   RiderVehicleType @default(BIKE)
  vehiclePlate  String?
  status        RiderStatus   @default(OFFLINE)
  rating        Float         @default(5)
  ratingCount   Int           @default(0)
  activeOrderCount Int        @default(0)
  totalDeliveries Int        @default(0)
  latitude      Float?
  longitude     Float?
  heading       Float?
  speedKmh      Float?
  locationUpdatedAt DateTime?
  lastSeenAt    DateTime?
  isApproved    Boolean       @default(false)
  documentsUrl  String?
  locationHistory RiderLocationHistory[]
  assignments   RiderAssignment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([isApproved])
  @@index([latitude, longitude])
  @@map("riders")
}

model RiderAssignment {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @db.Uuid @unique
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId      String      @db.Uuid
  rider        Rider       @relation(fields: [riderId], references: [id])
  status       String      @default("ASSIGNED")
  assignedAt   DateTime    @default(now())
  acceptedAt   DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  rejectedAt   DateTime?
  timedOutAt   DateTime?
  score        Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([riderId])
  @@index([status])
  @@map("rider_assignments")
}

model RiderLocationHistory {
  id        String   @id @default(uuid()) @db.Uuid
  riderId   String   @db.Uuid
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  heading   Float?
  speedKmh  Float?
  recordedAt DateTime @default(now())

  @@index([riderId, recordedAt])
  @@map("rider_location_history")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String          @db.Uuid @unique
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Float
  status          PaymentStatus   @default(PENDING)
  method          PaymentMethod  @default(CARD)
  transactionId   String?
  gateway         String?
  failureReason   String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@map("payments")
}

// ============================================================
// COUPONS & PROMOTIONS
// ============================================================

model Coupon {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  type            CouponType
  value           Float
  minOrderValue   Float          @default(0)
  maxDiscount     Float?
  restaurantId    String?        @db.Uuid
  restaurant      Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime?
  maxUsage        Int            @default(1)
  maxUsagePerUser Int            @default(1)
  totalUsage      Int            @default(0)
  isActive        Boolean        @default(true)
  stackable       Boolean        @default(false)
  usages          CouponUsage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([code])
  @@index([restaurantId])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id          String   @id @default(uuid()) @db.Uuid
  couponId    String   @db.Uuid
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  orderId     String?  @db.Uuid @unique
  order       Order?   @relation(fields: [orderId], references: [id])
  discountAmount Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

model Promotion {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  type          PromotionType
  scope         PromotionScope @default(RESTAURANT)
  value         Float
  restaurantId  String?        @db.Uuid
  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  minOrderValue Float          @default(0)
  maxUsage      Int            @default(0)
  totalUsage    Int            @default(0)
  isActive      Boolean        @default(true)
  stackable     Boolean        @default(false)
  deliveryZoneId String?      @db.Uuid
  deliveryZone  DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  bannerUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([scope])
  @@index([restaurantId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("promotions")
}

// ============================================================
// REVIEWS & FAVORITES
// ============================================================

model Review {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String?    @db.Uuid
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  foodItemId   String?    @db.Uuid
  foodItem     FoodItem?   @relation(fields: [foodItemId], references: [id])
  orderId      String?    @db.Uuid @unique
  order        Order?      @relation(fields: [orderId], references: [id])
  rating       Int
  comment      String?
  images       String[]
  isApproved   Boolean    @default(true)
  isFlagged    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
  @@index([foodItemId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model Favorite {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([userId])
  @@map("favorites")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================================
// BANNERS
// ============================================================

model Banner {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  imageUrl    String
  placement   BannerPlacement  @default(HOME)
  linkType    String?
  linkValue   String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([placement])
  @@index([isActive])
  @@map("banners")
}

// ============================================================
// MEDIA (Cloudinary)
// ============================================================

model Media {
  id         String     @id @default(uuid()) @db.Uuid
  publicId   String
  url        String
  type       MediaType  @default(IMAGE)
  entityType EntityType
  entityId   String     @db.Uuid
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([publicId])
  @@map("media")
}

// ============================================================
// DELIVERY ZONE (Mapbox polygon)
// ============================================================

model DeliveryZone {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  description String?
  polygon     Json
  centerLat   Float?
  centerLng   Float?
  radius      Float?
  restaurants Restaurant[]
  promotions  Promotion[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("delivery_zones")
}

// ============================================================
// PLATFORM SETTINGS
// ============================================================

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  type      String   @default("string")
  category   String   @default("general")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ============================================================
// SEARCH INDEX (denormalized for hybrid search)
// ============================================================

model SearchIndex {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String   @db.Uuid @unique
  foodItemId  String   @db.Uuid @unique
  foodItem    FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  restaurantId String  @db.Uuid
  restaurantName String
  foodName    String
  categoryName String?
  description String?
  rating      Float    @default(0)
  orderCount  Int      @default(0)
  latitude    Float
  longitude   Float
  deliveryTimeMin Int?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType])
  @@index([restaurantId])
  @@index([rating])
  @@index([orderCount])
  @@index([foodName])
  @@map("search_index")
}

// ============================================================
// MESSAGING (Conversation / Message)
// ============================================================

model Conversation {
  id        String             @id @default(uuid()) @db.Uuid
  orderId   String             @db.Uuid @unique
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      ConversationType
  status    ConversationStatus @default(OPEN)
  participants ConversationParticipant[]
  messages  Message[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("conversations")
}

model ConversationParticipant {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String       @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String
  lastReadAt      DateTime?
  createdAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String       @db.Uuid
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type            MessageType  @default(TEXT)
  body            String?
  imageUrl        String?
  readAt          DateTime?
  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}
